{
  "name": "music-cloud",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43217",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43217",
    "lint": "eslint",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "theme:build": "astryx theme build src/theme/bricolaTheme.ts -o src/theme/bricola.css",
    "theme:check": "astryx theme build src/theme/bricolaTheme.ts -o src/theme/bricola.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@base-ui/react": "^1.8.0",
    "@stylexjs/stylex": "^0.19.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "d3-force": "^3.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.46.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "allowScripts": {
    "@astryxdesign/cli": true,
    "@astryxdesign/core": true,
    "unrs-resolver": true
  }
}
